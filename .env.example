# Copy to .env and fill in what you use. Nothing here is required at import time.

# --- Anthropic (default provider: claude-fable-5-2) -------------------------
# Option 1: API key.
ANTHROPIC_API_KEY=

# Option 2: Workload Identity Federation (keyless). Leave ANTHROPIC_API_KEY and
# ANTHROPIC_AUTH_TOKEN unset: either one takes precedence over federation.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# ANTHROPIC_IDENTITY_TOKEN_FILE=/path/to/oidc-token

# --- Literature verification -----------------------------------------------
# Optional but recommended: raises the Semantic Scholar rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# --- Optional providers (uv sync --extra gemini / --extra openai) ----------
# GEMINI_API_KEY=
# VERTEX_AI_PROJECT=
# VERTEX_AI_LOCATION=
# OPENAI_API_KEY=

# --- Web app (paper-orchestra ui) -------------------------------------------
# The app is opened with a link that carries an access token. Every start makes a new
# one; set this (16 characters or more: letters, digits, - . _ ~) to keep one token
# across restarts, for a bookmark or a script. Whoever has it uses the app as you.
# PAPER_ORCHESTRA_UI_TOKEN=

# --- Memory -----------------------------------------------------------------
# Where the cross-run "lab" memory lives (default: ~/.paper_orchestra/memory).
# PAPER_ORCHESTRA_MEMORY_DIR=

# --- Figures ----------------------------------------------------------------
# Optional checkout of PaperBanana for few-shot figure examples and style guides.
# Without it, figures are planned zero-shot with a built-in style guide.
# PAPER_BANANA_DIR=

# --- Templates --------------------------------------------------------------
# A directory of your own LaTeX templates, looked up by name before the bundled ones.
# PAPER_ORCHESTRA_TEMPLATES=

# --- Modal (uv sync --extra modal; run `modal setup` once) ------------------
# Read when running or deploying the Modal app, and by --compute modal.
# PAPER_ORCHESTRA_MODAL_SECRET=paper-orchestra   # Modal Secret with the credentials; "none" for keyless
# PAPER_ORCHESTRA_MODAL_VOLUME=paper-orchestra   # Volume for runs and the lab memory
# PAPER_ORCHESTRA_MODAL_TIMEOUT=21600            # seconds one attempt at a paper may take
# PAPER_ORCHESTRA_MODAL_MAX_CONTAINERS=4         # papers written at the same time
# PAPER_ORCHESTRA_MODAL_LATEX=local              # compile in the pipeline container (default: a nested sandbox)
# PAPER_ORCHESTRA_MODAL_TEX_PACKAGES="texlive-lang-german"   # extra Debian packages for the TeX images
