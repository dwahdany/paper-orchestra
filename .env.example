# Copy to .env and fill in what you use. Nothing here is required at import time.

# --- Anthropic (default provider: claude-fable-5-2) -------------------------
# Option 1: API key.
ANTHROPIC_API_KEY=

# Option 2: Workload Identity Federation (keyless). Leave ANTHROPIC_API_KEY and
# ANTHROPIC_AUTH_TOKEN unset: either one takes precedence over federation.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# ANTHROPIC_IDENTITY_TOKEN_FILE=/path/to/oidc-token

# --- Literature verification -----------------------------------------------
# Optional but recommended: raises the Semantic Scholar rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# --- Optional providers (uv sync --extra gemini / --extra openai) ----------
# GEMINI_API_KEY=
# VERTEX_AI_PROJECT=
# VERTEX_AI_LOCATION=
# OPENAI_API_KEY=

# --- Memory -----------------------------------------------------------------
# Where the cross-run "lab" memory lives (default: ~/.paper_orchestra/memory).
# PAPER_ORCHESTRA_MEMORY_DIR=

# --- Figures ----------------------------------------------------------------
# Optional checkout of PaperBanana for few-shot figure examples.
# PAPER_BANANA_DIR=

# --- Frontend notifications --------------------------------------------------
# SMTP_EMAIL=
# SMTP_PASSWORD=
